# Azure Document Intelligence
AZURE_DOC_INTELLIGENCE_ENDPOINT=https://your-doc-intelligence.cognitiveservices.azure.com/
AZURE_DOC_INTELLIGENCE_KEY=your-doc-intelligence-api-key

# Azure Translator
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com/
AZURE_TRANSLATOR_KEY=your-translator-api-key
AZURE_TRANSLATOR_REGION=your-region

# Azure Speech Services
AZURE_SPEECH_KEY=your-speech-api-key
AZURE_SPEECH_REGION=your-region

# Azure Storage
AZURE_STORAGE_CONNECTION_STRING=your-storage-connection-string
AZURE_STORAGE_CONTAINER_NAME=cognitive-services-uploads

# Application Settings
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_SIZE_MB=50
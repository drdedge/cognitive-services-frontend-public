# Azure Cognitive Services - Document Intelligence
AZURE_DOC_INTELLIGENCE_ENDPOINT=https://your-endpoint.cognitiveservices.azure.com/
AZURE_DOC_INTELLIGENCE_KEY=your-key-here
AZURE_DOC_INTELLIGENCE_MODEL=layout
AZURE_DOC_INTELLIGENCE_REGION=eastus

# Azure Cognitive Services - Translator
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com/
AZURE_TRANSLATOR_KEY=your-key-here
AZURE_TRANSLATOR_REGION=global

# Azure Cognitive Services - Speech Services
AZURE_SPEECH_ENDPOINT=https://your-region.api.cognitive.microsoft.com/
AZURE_SPEECH_KEY=your-key-here
AZURE_SPEECH_REGION=eastus

# Azure Storage
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=youraccountname;AccountKey=yourkey;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=cognitive-services
AZURE_STORAGE_ACCOUNT_NAME=youraccountname
AZURE_STORAGE_ACCOUNT_KEY=yourkey

# Application Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
API_BASE_URL=http://localhost:8000
FRONTEND_PORT=3000

# Performance Settings (optional)
MAX_FILE_SIZE_MB=50
JOB_TIMEOUT_MINUTES=30
CLEANUP_INTERVAL_HOURS=24
MAX_CONCURRENT_JOBS=10
WEBSOCKET_TIMEOUT_SECONDS=300
AZURE_TIMEOUT_SECONDS=120

# Frontend Settings (for Vite)
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws